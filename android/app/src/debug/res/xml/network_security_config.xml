<?xml version="1.0" encoding="utf-8"?>
<!-- Debug policy. The release build does not merge this file.
     HTTP is limited to loopback and the emulator host.
     A debug build also adds the machine's private LAN addresses
     via generateDebugNetworkSecurity in app/build.gradle.kts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
