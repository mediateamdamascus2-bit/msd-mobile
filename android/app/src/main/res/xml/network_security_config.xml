<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile: cleartext is forbidden. Debug builds use a generated config that allows HTTP only for local-network hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
